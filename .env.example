# PostgreSQL (docker compose up -d postgres)
DATABASE_URL=postgresql+asyncpg://orchestrator:orchestrator@localhost:5432/orchestrator

# Absolute path under which every task workspace is created. All CLI cwd values must resolve inside it.
WORKSPACE_ROOT=./workspaces

# CLI executables (resolved with shutil.which when not absolute)
CODEX_BIN=codex
CLAUDE_BIN=claude

# Runner / lease
LEASE_TTL_SECONDS=60
CLAIM_TIMEOUT_SECONDS=300

# Parallel execution inside the single Runner process
MAX_CONCURRENT_TASKS=2
MAX_TASKS_PER_PROJECT=1
MAX_CONCURRENT_CLI_PROCESSES=4
RUNNER_SHUTDOWN_GRACE_SECONDS=30

# Database pool (see README: DB pool). DB_POOL_SIZE unset = 4 * MAX_CONCURRENT_TASKS + 6; DB_MAX_OVERFLOW=0 is allowed
# DB_POOL_SIZE=14
DB_MAX_OVERFLOW=10

# Projects registered by repository_url are cloned below this directory only
PROJECT_CLONE_ROOT=./project-clones
